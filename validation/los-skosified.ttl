<https://id.norge.no/los> a skos:ConceptScheme ;
    dct:description "Los is a shared controlled vocabulary for classifying public services, information and resources in Norway. This is a release candidate. Feedback can be submitted via https://datalandsbyen.norge.no/category/20/revisjon-av-los"@en,
        "Los er et felles kontrollert vokabular for klassifisering av offentlige tjenester, informasjon og ressurser i Norge. Dette er en publiseringskandidat. Tilbakemeldinger kan sendes via https://datalandsbyen.norge.no/category/20/revisjon-av-los"@nb,
        "Los er eit felles kontrollert vokabular for klassifisering av offentlege tenester, informasjon og ressursar i Noreg. Dette er ein utgivingskandidat. Tilbakemeldingar kan sendast via https://datalandsbyen.norge.no/category/20/revisjon-av-los"@nn ;
    dct:hasVersion "4.0.0-rc.1" ;
    dct:issued "2026-08-06"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher "The Norwegian Digitalisation Agency"@en,
        "Digitaliseringsdirektoratet"@nb,
        "Digitaliseringsdirektoratet"@nn ;
    dct:title "Los"@en,
        "Los"@nb,
        "Los"@nn ;
    owl:versionInfo "Los 4.0 RC1" ;
